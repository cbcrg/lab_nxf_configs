//
// Process definition
//
process {
    beforeScript = 'module load Singularity/3.4.0'
    executor     = 'crg'
    // scratch      = true
}

profiles {
    bovreg {
        process {
            // Default queue assignation
            queue = { task.time <= 6.h ? 'short-centos79': 'long-centos79' }
            clusterOptions = '-P prj007053'
        }

        params {
            max_memory = 128.GB
            max_cpus   = 16
        }
    }
}

